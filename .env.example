# Copy to .env and fill in. Never commit the real .env.

# Reddit API (https://www.reddit.com/prefs/apps) - needed for PRAW
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=discovery-engine/0.1 by <your-reddit-username>

# Groq (https://console.groq.com/keys) - Llama 3.3 for open-coding, tagging, and the chatbot
GROQ_API_KEY=
